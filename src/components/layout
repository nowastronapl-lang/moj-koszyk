'use client';

import Link from 'next/link';
import { usePathname } from 'next/navigation';
import { Home, ShoppingBag, PieChart, User, Plus } from 'lucide-react';

const navItems = [
  { href: '/', label: 'Start', icon: Home },
  { href: '/zakupy', label: 'Zakupy', icon: ShoppingBag },
  { href: '/analiza', label: 'Analiza', icon: PieChart },
  { href: '/konto', label: 'Konto', icon: User },
];

export function Navigation() {
  const pathname = usePathname();

  if (pathname === '/skanuj' || pathname === '/analizowanie') return null;

  return (
    <>
      {/* Desktop Sidebar */}
      <aside className="hidden lg:flex flex-col w-64 h-screen fixed left-0 top-0 bg-card-light border-r border-border-light p-6 z-30">
        <div className="flex items-center gap-3 mb-8">
          <div className="w-10 h-10 rounded-btn bg-brand-green flex items-center justify-center text-white font-bold text-lg">
            MK
          </div>
          <span className="text-xl font-bold text-txt-primary-light">Mój Koszyk</span>
        </div>

        <Link
          href="/dodaj"
          className="flex items-center justify-center gap-2 w-full py-3 px-4 bg-brand-green text-white rounded-btn font-semibold mb-8 shadow-sm"
        >
          <Plus size={20} />
          <span>Dodaj paragon</span>
        </Link>

        <nav className="flex flex-col gap-1">
          {navItems.map((item) => {
            const Icon = item.icon;
            const isActive = pathname === item.href;
            return (
              <Link
                key={item.href}
                href={item.href}
                className={`flex items-center gap-3 px-4 py-3 rounded-btn transition-colors ${
                  isActive ? 'bg-bg-light font-semibold text-brand-green' : 'text-txt-secondary-light'
                }`}
              >
                <Icon size={20} />
                <span>{item.label}</span>
              </Link>
            );
          })}
        </nav>
      </aside>

      {/* Mobile Bottom Navigation */}
      <div className="lg:hidden fixed bottom-0 left-0 right-0 z-40">
        <div className="flex justify-center -mb-5 relative z-10 pointer-events-none">
          <Link
            href="/dodaj"
            className="pointer-events-auto flex items-center gap-2 bg-brand-green text-white px-5 py-3 rounded-badge font-semibold shadow-lg"
          >
            <Plus size={20} />
            <span>Dodaj paragon</span>
          </Link>
        </div>

        <nav className="bg-card-light border-t border-border-light px-4 pt-4 pb-6 flex justify-around items-center">
          {navItems.map((item) => {
            const Icon = item.icon;
            const isActive = pathname === item.href;
            return (
              <Link
                key={item.href}
                href={item.href}
                className={`flex flex-col items-center gap-1 text-xs ${
                  isActive ? 'text-brand-green font-semibold' : 'text-txt-secondary-light'
                }`}
              >
                <Icon size={22} />
                <span>{item.label}</span>
              </Link>
            );
          })}
        </nav>
      </div>
    </>
  );
}